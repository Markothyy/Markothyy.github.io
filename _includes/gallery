{%- if page.gallery and page.gallery.size > 0 %}
<figure class="gallery">
  <div class="gallery__grid">
    {%- for img in page.gallery %}
    {%- assign src = img.image_path | default: img.url %}
    {%- assign first = src | slice: 0 %}
    {%- unless first == '/' %}{% assign src = '/' | append: src %}{% endunless %}
    <a class="gallery__item" href="{{ src | relative_url }}">
      <img src="{{ src | relative_url }}" alt="{{ img.alt | default: img.title | escape }}" loading="lazy">
    </a>
    {%- endfor %}
  </div>
  {%- if include.caption %}
  <figcaption>{{ include.caption }}</figcaption>
  {%- endif %}
</figure>
{%- endif %}
